# BBA Ops — Environment Variables Template
# Copy to .env and fill in values. Never commit .env.

# Instantly (cold email CRM)
INSTANTLY_API_KEY=
INSTANTLY_ASSESSMENT_LIST_ID=7eac5b71-46a6-491f-b3af-6801d35abeb9

# Apollo (prospect enrichment)
APOLLO_API_KEY=

# Supabase (database + memory)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Perplexity (real-time research)
PERPLEXITY_API_KEY=

# Firecrawl (web scraping)
FIRECRAWL_API_KEY=

# Apify (large-scale scraping)
APIFY_TOKEN=

# Hunter (email finding)
HUNTER_API_KEY=

# Google (YouTube, Sheets, Gmail, GA4)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
GOOGLE_SHEET_ID=
# Google OAuth credentials stored separately via scripts/google-reauth.js

# Meta Graph API (Instagram + Facebook stats)
META_APP_ID=                  # From developers.facebook.com — your app's ID
META_APP_SECRET=              # From developers.facebook.com — your app's secret
META_ACCESS_TOKEN=            # Long-lived Page Access Token (needed for Instagram followers)
META_PAGE_ID=                 # Facebook Page numeric ID (visible in page URL or Business Suite)
META_IG_ACCOUNT_ID=           # Instagram Business Account ID (Instagram > Settings > Account > scroll to bottom)

# n8n
N8N_API_KEY=
N8N_BASE_URL=https://n8n.srv1155250.hstgr.cloud

# Microsoft Clarity Export API
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=
CLARITY_SHEET_ID=

# Looker Studio dashboard sheets
INSTANTLY_SHEET_ID=
CLARITY_SHEET_ID=

# Content pipeline (Google Drive → Whisper → Claude → Slack → Buffer)
GOOGLE_DRIVE_FOLDER_ID=           # ID of the Drive folder to watch for new videos
OPENAI_API_KEY=                   # For Whisper transcription + OpenClaw fallback LLM (pay-per-use)
GEMINI_API_KEY=                   # OpenClaw primary LLM (free tier: aistudio.google.com)
GROQ_API_KEY=                     # OpenClaw fallback LLM (free tier: console.groq.com)
BUFFER_ACCESS_TOKEN=              # From Buffer dashboard (publish.buffer.com → settings → API)
BUFFER_IG_PROFILE_ID=             # Buffer profile ID for Instagram
BUFFER_LI_PROFILE_ID=             # Buffer profile ID for LinkedIn
SLACK_LISTENER_PORT=3001          # Internal port for n8n → slack-listener registration

# OpenClaw (VPS ambient agent)
OPENCLAW_WHATSAPP_NUMBER=
OPENCLAW_ALLOWED_FROM=
